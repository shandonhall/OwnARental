// Own A Rental — Prisma schema (Supabase PostgreSQL)
// Auth users typically mirror supabase.auth.users via matching UUID `id`.

generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  FLEET_MANAGER
  SALES
  FINANCE
}

enum FicaStatus {
  PENDING
  PARTIAL
  COMPLETE
  REJECTED
}

enum VehicleStatus {
  AVAILABLE
  ACTIVE
  ARREARS
  PAID_UP
  RETURNED
  WRITTEN_OFF
}

enum PlanType {
  CIP_10
  CIP_20
  LONG_TERM
}

enum ContractStatus {
  DRAFT
  ACTIVE
  ARREARS
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum EndOfTermStage {
  FINAL_90
  CONTACTED
  BALLOON_PENDING
  HANDOVER
  RETURNED
}

enum FineImportStatus {
  UNMATCHED
  MATCHED
  INVOICED
  VOID
}

enum LedgerEntryType {
  RENTAL_PAYMENT
  DEPOSIT
  BALLOON_PAYMENT
  FINE
  TOLL
  ADMIN_FEE
  MAINTENANCE
  ADJUSTMENT
  REFUND
}

enum LedgerEntryStatus {
  PENDING
  ON_TIME
  EARLY
  LATE
  FAILED
  VOID
}

enum NotificationKind {
  MISSED_PAYMENT
  ARREARS
  LATE_PAYMENT
  PENDING_FINE
  SERVICE_DUE
  RULE_BREACH
  END_OF_TERM
  SYSTEM
  LICENCE_DUE
  LEAD_ASSIGNED
}

enum NotificationSeverity {
  HIGH
  MEDIUM
  LOW
}

// ---------------------------------------------------------------------------
// Users (RBAC — dashboard staff; immobilize requires SUPER_ADMIN)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @db.Uuid // matches supabase.auth.users.id
  email        String   @unique
  fullName     String   @map("full_name")
  role         Role     @default(FLEET_MANAGER)
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ledgerEntries     LedgerEntry[]
  notificationReads NotificationRead[]
  assignedLeads     Lead[]             @relation("LeadAssignee")
  createdLeads      Lead[]             @relation("LeadCreator")
  leadAssignments   LeadAssignment[]   @relation("LeadAssignmentUser")
  leadAssignmentsMade LeadAssignment[] @relation("LeadAssignmentActor")
  leadStageActions  LeadStageHistory[] @relation("LeadStageActor")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Clients (renters + FICA — doc fields store Supabase Storage URLs only)
// ---------------------------------------------------------------------------

model Client {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String @map("first_name")
  lastName  String @map("last_name")
  idNumber  String @unique @map("id_number") // SA ID / passport
  email     String?
  phone     String
  altPhone  String? @map("alt_phone")

  // Address (POPIA — minimize retention; keep structured)
  addressLine1 String  @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city         String
  province     String?
  postalCode   String? @map("postal_code")

  ficaStatus FicaStatus @default(PENDING) @map("fica_status")

  // FICA document URLs → Supabase Storage (never binary blobs)
  idDocumentUrl         String? @map("id_document_url")
  driversLicenseUrl     String? @map("drivers_license_url")
  payslipsUrl           String? @map("payslips_url") // 6 months pack
  bankStatementsUrl     String? @map("bank_statements_url") // 6 months pack
  proofOfResidenceUrl   String? @map("proof_of_residence_url")
  handoverPhotosUrls    String[] @default([]) @map("handover_photos_urls")

  // GoHighLevel CRM sync
  ghlContactId String? @unique @map("ghl_contact_id")

  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contracts Contract[]
  leads     Lead[]

  @@index([lastName, firstName])
  @@index([phone])
  @@index([ficaStatus])
  @@index([isActive])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// Vehicles (fleet + CarTrack telematics + warranty)
// ---------------------------------------------------------------------------

model Vehicle {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  make           String
  model          String
  year           Int
  color          String?
  vin            String        @unique
  registration   String        @unique
  purchasePrice  Decimal       @map("purchase_price") @db.Decimal(12, 2)
  purchaseDate   DateTime?     @map("purchase_date") @db.Date
  status         VehicleStatus @default(AVAILABLE)

  // Contract mileage allowance (km / month) when on assignment
  monthlyMileageLimit Int? @map("monthly_mileage_limit")

  // --- CarTrack telematics ---
  carTrackDeviceId   String?   @unique @map("cartrack_device_id")
  lastKnownLat       Decimal?  @map("last_known_lat") @db.Decimal(10, 7)
  lastKnownLng       Decimal?  @map("last_known_lng") @db.Decimal(10, 7)
  lastLocationAt     DateTime? @map("last_location_at")
  currentOdometerKm  Int       @default(0) @map("current_odometer_km")
  driverScore        Int? // 0–100
  isImmobilized      Boolean   @default(false) @map("is_immobilized")
  lastImmobilizedAt  DateTime? @map("last_immobilized_at")
  lastTelematicsSyncAt DateTime? @map("last_telematics_sync_at")

  // Predictive maintenance helpers
  nextServiceDueKm   Int?      @map("next_service_due_km")
  nextServiceDueDate DateTime? @map("next_service_due_date") @db.Date
  averageDailyKm     Decimal?  @map("average_daily_km") @db.Decimal(8, 2)

  // --- Warranty tracking ---
  warrantyProvider   String?   @map("warranty_provider")
  warrantyStartDate  DateTime? @map("warranty_start_date") @db.Date
  warrantyExpiryDate DateTime? @map("warranty_expiry_date") @db.Date
  warrantyKmLimit    Int?      @map("warranty_km_limit")
  warrantyNotes      String?   @map("warranty_notes")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contracts Contract[]
  telematicsEvents TelematicsEvent[]
  requestedByLeads Lead[]

  @@index([status])
  @@index([make, model])
  @@index([nextServiceDueDate])
  @@index([warrantyExpiryDate])
  @@index([isImmobilized])
  @@map("vehicles")
}

enum TelematicsEventType {
  LOCATION
  MILEAGE
  DRIVER_SCORE
  RULE_BREACH
  IMMOBILIZE
  MOBILIZE
  SYNC
}

model TelematicsEvent {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId   String              @map("vehicle_id") @db.Uuid
  type        TelematicsEventType
  odometerKm  Int?                @map("odometer_km")
  lat         Decimal?            @db.Decimal(10, 7)
  lng         Decimal?            @db.Decimal(10, 7)
  driverScore Int?                @map("driver_score")
  message     String?
  payload     Json?
  recordedAt  DateTime            @default(now()) @map("recorded_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt])
  @@index([type])
  @@map("telematics_events")
}

// ---------------------------------------------------------------------------
// Contracts (Client ↔ Vehicle rent-to-own link)
// ---------------------------------------------------------------------------

model Contract {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId String @map("client_id") @db.Uuid
  vehicleId String @map("vehicle_id") @db.Uuid

  planType        PlanType       @map("plan_type")
  status          ContractStatus @default(DRAFT)
  termMonths      Int            @map("term_months")
  monthlyRate     Decimal        @map("monthly_rate") @db.Decimal(12, 2)
  depositAmount   Decimal        @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  balloonAmount   Decimal?       @map("balloon_amount") @db.Decimal(12, 2)
  cipPercent      Int?           @map("cip_percent") // 10 or 20 when CIP plan
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime       @map("end_date") @db.Date
  monthlyKmLimit  Int?           @map("monthly_km_limit")

  // Running financials (denormalized for dashboard KPIs; ledger is source of truth)
  totalPaid           Decimal @default(0) @map("total_paid") @db.Decimal(12, 2)
  outstandingBalance  Decimal @default(0) @map("outstanding_balance") @db.Decimal(12, 2)

  // End-of-term / GHL pipeline
  ghlOpportunityId String? @map("ghl_opportunity_id")
  endOfTermNotifiedAt DateTime? @map("end_of_term_notified_at")
  endOfTermStage EndOfTermStage? @map("end_of_term_stage")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  ledger  LedgerEntry[]
  fineImports FineImport[]
  wonLeads Lead[]

  @@index([clientId])
  @@index([vehicleId])
  @@index([status])
  @@index([planType])
  @@index([endDate])
  @@index([status, endDate])
  @@index([endOfTermStage])
  @@map("contracts")
}

// ---------------------------------------------------------------------------
// Financial Ledger (all money movements against a contract)
// ---------------------------------------------------------------------------

model LedgerEntry {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId String            @map("contract_id") @db.Uuid
  type       LedgerEntryType
  status     LedgerEntryStatus @default(PENDING)
  amount     Decimal           @db.Decimal(12, 2)
  currency   String            @default("ZAR") @db.Char(3)

  dueDate    DateTime? @map("due_date") @db.Date
  paidAt     DateTime? @map("paid_at")
  reference  String? // bank ref / invoice number
  description String?
  metadata   Json? // fine IDs, GHL message IDs, etc.

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([createdById])
  @@index([type])
  @@index([status])
  @@index([paidAt])
  @@index([dueDate])
  @@index([contractId, status])
  @@index([contractId, paidAt])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Notifications (staff alert feed — deduped operational flags)
// ---------------------------------------------------------------------------

model Notification {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupeKey String               @unique @map("dedupe_key")
  kind      NotificationKind
  severity  NotificationSeverity @default(MEDIUM)
  title     String
  detail    String
  href      String?
  amount    Decimal?             @db.Decimal(12, 2)
  entityType String?             @map("entity_type")
  entityId   String?             @map("entity_id") @db.Uuid
  active    Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  reads NotificationRead[]

  @@index([active, createdAt])
  @@index([kind])
  @@map("notifications")
}

model NotificationRead {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String   @map("notification_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_reads")
}

// ---------------------------------------------------------------------------
// Fine / toll imports (AARTO / SANRAL / municipal)
// ---------------------------------------------------------------------------

model FineImport {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId       String           @unique @map("external_id")
  source           String
  registration     String
  offenceDate      DateTime?        @map("offence_date")
  amount           Decimal          @db.Decimal(12, 2)
  description      String?
  rawPayload       Json?            @map("raw_payload")
  contractId       String?          @map("contract_id") @db.Uuid
  fineLedgerId     String?          @unique @map("fine_ledger_id") @db.Uuid
  adminFeeLedgerId String?          @unique @map("admin_fee_ledger_id") @db.Uuid
  invoicedAt       DateTime?        @map("invoiced_at")
  status           FineImportStatus @default(UNMATCHED)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([registration])
  @@index([status])
  @@index([contractId])
  @@map("fine_imports")
}

// ---------------------------------------------------------------------------
// Leads (sales pipeline — already live in Supabase)
// ---------------------------------------------------------------------------

enum LeadSource {
  META_LEAD_FORM
  WEBSITE
  MANUAL
  PHONE_IN
  FACEBOOK_MESSENGER
  OTHER
}

enum LeadCreativeType {
  VIDEO
  GRAPHIC
  UNKNOWN
}

enum LeadDeliverySystem {
  NONE
  VMG
  OTHER
}

enum LeadContactChannel {
  PHONE
  WHATSAPP
  EMAIL
  SMS
  OTHER
}

enum LeadQualificationStatus {
  UNASSESSED
  QUALIFIED
  UNQUALIFIED
}

enum LeadDisqualificationReason {
  UBER_BOLT
  AFFORDABILITY
  INVALID_OR_NO_DRIVERS_LICENCE
  UNREACHABLE
  NOT_INTERESTED
  OUTSIDE_REQUIREMENTS
  NO_SUITABLE_VEHICLE
  DUPLICATE
  OTHER
}

enum LeadLossReason {
  APPLICATION_DECLINED
  CUSTOMER_WITHDREW
  NO_SUITABLE_VEHICLE
  UNREACHABLE
  DUPLICATE
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFYING
  DOCUMENTS_REQUESTED
  APPLICATION_SUBMITTED
  APPROVED
  VEHICLE_SELECTED
  CLOSED_WON
  CLOSED_LOST
}

model Lead {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String @map("first_name")
  lastName  String @map("last_name")
  cellphone String
  email     String?
  area      String?
  salaryBand String? @map("salary_band")
  rentalType String? @map("rental_type")
  vehicleNeededTiming String? @map("vehicle_needed_timing")
  vehiclePreference   String? @map("vehicle_preference")
  hasValidDriversLicence Boolean? @map("has_valid_drivers_licence")
  requestedVehicleId String? @map("requested_vehicle_id") @db.Uuid

  source       LeadSource
  sourceDetail String?    @map("source_detail")
  platform     String?
  sourceCreatedAt DateTime? @map("source_created_at")
  campaignId   String? @map("campaign_id")
  campaignName String? @map("campaign_name")
  adSetId      String? @map("ad_set_id")
  adSetName    String? @map("ad_set_name")
  adId         String? @map("ad_id")
  adName       String? @map("ad_name")
  formId       String? @map("form_id")
  formName     String? @map("form_name")
  creativeType LeadCreativeType @default(UNKNOWN) @map("creative_type")
  creativeLabel String? @map("creative_label")
  utmSource    String? @map("utm_source")
  utmMedium    String? @map("utm_medium")
  utmCampaign  String? @map("utm_campaign")
  utmContent   String? @map("utm_content")
  externalLeadId String? @map("external_lead_id")

  assignedUserId String?   @map("assigned_user_id") @db.Uuid
  assignedAt     DateTime? @map("assigned_at")
  firstAttemptAt DateTime? @map("first_attempt_at")
  firstAttemptChannel LeadContactChannel? @map("first_attempt_channel")
  firstContactAt DateTime? @map("first_contact_at")
  firstContactChannel LeadContactChannel? @map("first_contact_channel")
  lastContactAt  DateTime? @map("last_contact_at")

  stage               LeadStage               @default(NEW)
  qualificationStatus LeadQualificationStatus @default(UNASSESSED) @map("qualification_status")
  disqualificationReason LeadDisqualificationReason? @map("disqualification_reason")
  disqualificationNotes  String? @map("disqualification_notes")
  lossReason          LeadLossReason? @map("loss_reason")
  lossNotes           String?         @map("loss_notes")
  documentsReceivedAt DateTime?       @map("documents_received_at")
  closedAt            DateTime?       @map("closed_at")

  clientId          String? @map("client_id") @db.Uuid
  wonContractId     String? @map("won_contract_id") @db.Uuid
  duplicateOfLeadId String? @map("duplicate_of_lead_id") @db.Uuid

  deliverySystem          LeadDeliverySystem @default(NONE) @map("delivery_system")
  externalDeliveryId      String? @map("external_delivery_id")
  externalDeliveryStatus  String? @map("external_delivery_status")
  externalDeliveredAt     DateTime? @map("external_delivered_at")

  notes           String?
  archivedAt      DateTime? @map("archived_at")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  assignedUser     User?    @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdByUser    User?    @relation("LeadCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  requestedVehicle Vehicle? @relation(fields: [requestedVehicleId], references: [id], onDelete: SetNull)
  client           Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  wonContract      Contract? @relation(fields: [wonContractId], references: [id], onDelete: SetNull)
  duplicateOf      Lead?    @relation("LeadDuplicate", fields: [duplicateOfLeadId], references: [id], onDelete: SetNull)
  duplicates       Lead[]   @relation("LeadDuplicate")
  stageHistory     LeadStageHistory[]
  assignments      LeadAssignment[]

  @@index([stage])
  @@index([source])
  @@index([assignedUserId])
  @@index([cellphone])
  @@index([createdAt])
  @@index([qualificationStatus])
  @@map("leads")
}

model LeadStageHistory {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId      String     @map("lead_id") @db.Uuid
  fromStage   LeadStage? @map("from_stage")
  toStage     LeadStage  @map("to_stage")
  actorUserId String?    @map("actor_user_id") @db.Uuid
  changedAt   DateTime   @default(now()) @map("changed_at")
  reason      String?

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation("LeadStageActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leadId, changedAt])
  @@map("lead_stage_histories")
}

model LeadAssignment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId           String    @map("lead_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at")
  unassignedAt     DateTime? @map("unassigned_at")
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  reason           String?

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       User  @relation("LeadAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("LeadAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@map("lead_assignments")
}
