# Copy to prisma/.env — never commit real values.

# Postgres (Supabase pooler + direct for migrations)
DATABASE_URL=
DIRECT_URL=

# Supabase (Auth JWT verification on API; same URL/anon as web for local dev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — FICA Storage uploads / signed URLs (future)
# SUPABASE_SERVICE_ROLE_KEY=

# Production dashboard origin for API CORS (e.g. https://dashboard.example.com)
# WEB_ORIGIN=

# Production: false (staff must exist in public.users). Dev defaults to auto-provision.
# STAFF_AUTO_PROVISION=false

# Optional integrations (mock if unset)
# REDIS_URL=
# GHL_API_KEY=
# CARTRACK_API_KEY=
